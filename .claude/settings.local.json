{
  "permissions": {
    "allow": [
      "Bash(curl:*)",
      "WebFetch(domain:0.0.0.0)",
      "WebFetch(domain:host.docker.internal)",
      "WebFetch(domain:172.17.0.1)",
      "Bash(pip:*)",
      "Bash(python3:*)",
      "Bash(.venv/bin/openapi-python-client generate:*)",
      "Bash(.venv/bin/pip install:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(python:*)",
      "Bash(echo:*)",
      "Bash(source:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(git:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/dialog-information.oga"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga"
          }
        ]
      }
    ]
  }
}